{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noCheck": true,
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.ts",
    "services/**/*.ts",
    "deploy/**/*.ts"
  ]
}
