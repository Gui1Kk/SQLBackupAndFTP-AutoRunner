# URL pública acessada pelos operadores e pelos agentes.
# Para teste somente dentro da LAN: http://IP_DA_VM
# Para TLS automático com DNS apontando para a VM: https://autorunner.seudominio.com.br
PUBLIC_BASE_URL=http://192.168.1.50
PUBLIC_WS_URL=ws://192.168.1.50/ws/agent
AUTORUNNER_SITE_ADDRESS=http://192.168.1.50
TRUSTED_ORIGINS=http://192.168.1.50

POSTGRES_DB=autorunner
POSTGRES_USER=autorunner
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_PLUS

BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_48_PLUS
AGENT_SECRET_PEPPER=CHANGE_ME_RANDOM_48_PLUS
REALTIME_SIGNING_SECRET=CHANGE_ME_RANDOM_48_PLUS
INTERNAL_SERVICE_SECRET=CHANGE_ME_RANDOM_48_PLUS
WEBHOOK_ENCRYPTION_KEY=CHANGE_ME_RANDOM_48_PLUS

BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MIN_16
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ORGANIZATION_NAME=Alpha Software

HTTP_PORT=80
HTTPS_PORT=443
COMMAND_DEFAULT_TTL_SECONDS=900
COMMAND_MAX_RUNNING_SECONDS=86400
MAX_AGENT_MESSAGE_BYTES=1048576
MAX_CLI_OUTPUT_BYTES=65536
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_FIELDS=250
GRAPHQL_MAX_BODY_BYTES=1048576
GRAPHQL_REQUESTS_PER_MINUTE=300
GRAPHQL_ALLOW_INTROSPECTION=false
WEBSOCKET_UPGRADES_PER_MINUTE=120
APPROVED_AGENT_VERSION=3.0.0-RC
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_AFTER_SECONDS=90
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=8
EVENT_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
# Para integrar um webhook interno, prefira liberar somente hosts explícitos, separados por vírgula.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_HTTP=false
